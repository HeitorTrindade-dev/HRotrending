# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha
# HOST/PORT valem para rodar o Python direto na sua máquina.
# No Docker Compose o app usa host "db"; POSTGRES_PORT vira só a porta exposta no seu computador.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=roblox

# --- Pool de conexões (opcional) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# 1 para logar todas as queries SQL no console (debug), 0 para desligar
SQL_ECHO=0
